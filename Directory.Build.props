<Project>
  <!-- Shared settings for every project. Version is defined once here and flows to
       assemblies, the installer, and the Home Assistant sw_version (spec 8). -->
  <PropertyGroup>
    <Version>1.0.0</Version>
    <Product>Smart Home Relay</Product>
    <Company>Smart Home Relay</Company>
    <Copyright>Copyright © 2026</Copyright>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Required for IDE0005 (unused usings) to run during build. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- XML docs are required on Core public APIs only (spec 10); see Core's csproj. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Lets the Windows-targeted projects build on non-Windows machines (e.g. for analysis);
         they still only run on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <WindowsTargetFramework>net10.0-windows10.0.17763.0</WindowsTargetFramework>
    <PortableTargetFramework>net10.0</PortableTargetFramework>
  </PropertyGroup>
</Project>
