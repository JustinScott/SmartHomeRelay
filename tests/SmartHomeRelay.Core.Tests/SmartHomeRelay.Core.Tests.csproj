<Project Sdk="Microsoft.NET.Sdk">

  <!-- Fast unit tests. No Windows required (spec 9). -->
  <PropertyGroup>
    <TargetFramework>$(PortableTargetFramework)</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>SmartHomeRelay.Core.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SmartHomeRelay.Core\SmartHomeRelay.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Real container to test DI registration end to end. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>

</Project>
