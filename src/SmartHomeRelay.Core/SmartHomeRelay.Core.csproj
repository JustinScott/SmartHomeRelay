<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure, testable logic. Must never reference Windows or UI assemblies (spec 3.2). -->
  <PropertyGroup>
    <TargetFramework>$(PortableTargetFramework)</TargetFramework>
    <RootNamespace>SmartHomeRelay.Core</RootNamespace>
    <!-- Public APIs in Core require XML doc comments (spec 10). -->
    <NoWarn>$(NoWarn.Replace('CS1591', ''))</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- settings.json as an Options source with reload (spec 7). -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="MQTTnet" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SmartHomeRelay.Core.Tests" />
  </ItemGroup>

</Project>
